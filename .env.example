# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kitchen_me?schema=public"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Kitchen-me"
NEXT_PUBLIC_STORE_DESCRIPTION="Bold home and kitchen lifestyle goods for EU & UK."

# Email (Resend — no-op in dev when blank)
RESEND_API_KEY=""
EMAIL_FROM="Kitchen-me <orders@kitchen-me.com>"

## Observability
# Sentry — error tracking + performance (Tier 1)
# Get DSN: https://sentry.io → Project Settings → Client Keys
# Leave blank = Sentry silently disabled
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# PostHog — product analytics + funnels (Tier 1)
# Get key: https://app.posthog.com → Project Settings
# Leave blank = disabled
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Mixpanel — advanced product analytics (Tier 2, optional)
# Get token: https://mixpanel.com → Project Settings
# Leave blank = all Mixpanel calls are no-ops
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# Datadog — APM + infrastructure (Tier 2, optional)
# Get keys: https://app.datadoghq.com → Organization Settings → API Keys
# Leave DD_API_KEY blank = tracer init skipped
DD_API_KEY=""
DD_APP_KEY=""
DD_SERVICE="kitchen-me"
DD_ENV="development"

# Vercel Analytics + Speed Insights — Tier 1, zero config on Vercel

# Payments (MOCK at launch — swap to Stripe later)
# PAYMENT_PROVIDER=mock (default) | stripe
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
